.page {
  padding-bottom: 220rpx;
  min-height: 100vh;
}

.mt-24 {
  margin-top: 24rpx;
}

/* ---------------- 班制卡片 ---------------- */
.shift-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.shift-card__label {
  font-size: 32rpx;
  color: #8a94a6;
  margin-bottom: 12rpx;
}

.shift-card__value {
  display: flex;
  align-items: center;
}

.shift-card__type {
  margin-left: 16rpx;
  font-size: 36rpx;
  color: #4e5969;
  font-weight: 600;
}

.shift-card__btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 0 36rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #0052d9;
  background: #e7f0ff;
  border-radius: 44rpx;
}
.shift-card__btn:active {
  background: #cfe0ff;
}

/* ---------------- 模式切换 ---------------- */
.mode-tabs {
  display: flex;
  margin: 24rpx;
  padding: 8rpx;
  background: #e8ebf0;
  border-radius: 20rpx;
}
.mode-tabs__item {
  flex: 1;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #5a6472;
  border-radius: 16rpx;
}
.mode-tabs__item.is-active {
  background: #fff;
  color: #0052d9;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

/* ---------------- 时钟 ---------------- */
.clock {
  text-align: center;
  padding: 16rpx 0 36rpx;
}
.clock__time {
  font-size: 88rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
  letter-spacing: 2rpx;
}
.clock__date {
  margin-top: 8rpx;
  font-size: 34rpx;
  color: #4e5969;
}

.hint {
  text-align: center;
  font-size: 34rpx;
  color: #8a94a6;
  line-height: 1.7;
  margin-bottom: 28rpx;
}

/* ---------------- 待下班 ---------------- */
.pending-box {
  background: #f7f9fc;
  border: 2rpx solid #e3e6eb;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 32rpx;
}
.pending-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}
.pending-row__k {
  font-size: 34rpx;
  color: #4e5969;
}
.pending-row__v {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.pending-row__v--hl {
  color: #0052d9;
}

/* ---------------- 今日记录 ---------------- */
.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.list-head__title {
  margin-bottom: 0;
}
.list-head__sum {
  font-size: 34rpx;
  color: #4e5969;
}
.list-head__num {
  font-size: 40rpx;
  color: #0052d9;
  margin: 0 6rpx;
}

.rec-item {
  display: flex;
  align-items: stretch;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f2f5;
}
.rec-item:last-child {
  border-bottom: none;
}

/* 三列等结构，每列内容水平 + 垂直居中 */
.rec-item__col {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  min-width: 0;
  padding: 0 8rpx;
}
.rec-item__col--shift {
  flex: 1.1;
}
.rec-item__col--hours {
  flex: 1.4;
}
.rec-item__col--del {
  flex: 0 0 132rpx;
}

.rec-item__type {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #4e5969;
}
.rec-item__time {
  margin-top: 4rpx;
  font-size: 30rpx;
  color: #8a94a6;
}
.rec-item__hours {
  color: #1a1a1a;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}
.rec-item__h {
  font-size: 30rpx;
  font-weight: 400;
  color: #4e5969;
  margin-left: 6rpx;
}
.rec-item__units {
  font-size: 30rpx;
  color: #8a94a6;
  margin-top: 4rpx;
}
.rec-item__del {
  width: 116rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  color: #e34d59;
  background: #fdeff0;
  border-radius: 12rpx;
}
.rec-item__del:active {
  opacity: 0.7;
}

/* ---------------- 结果弹层 ---------------- */
.result {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 901;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
}
.result__icon {
  font-size: 96rpx;
  line-height: 1;
}
.result__title {
  font-size: 44rpx;
  font-weight: 700;
  margin: 16rpx 0 28rpx;
}
.result__rows {
  text-align: left;
  background: #f7f9fc;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 36rpx;
}
.result__row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 12rpx 0;
}
.result__k {
  font-size: 34rpx;
  color: #4e5969;
}
.result__v {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}

/* TDesign 弹窗字号放大 */
.dialog-content--big {
  font-size: 36rpx !important;
  line-height: 1.7 !important;
}

.foot-space {
  height: 20rpx;
}
