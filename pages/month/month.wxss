.page {
  padding-bottom: 220rpx;
  min-height: 100vh;
}

/* ---------------- 月份切换 ---------------- */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
}
.month-nav__btn {
  padding: 0 20rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #0052d9;
  background: #e7f0ff;
  border-radius: 16rpx;
}
.month-nav__btn:active {
  background: #cfe0ff;
}
.month-nav__ym {
  font-size: 34rpx;
  white-space: nowrap;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
  padding: 0 12rpx;
}

/* ---------------- 汇总卡 ---------------- */
.sum-card {
  background: linear-gradient(135deg, #0052d9, #2b7bff);
  color: #fff;
}
.sum-card__row {
  text-align: center;
  padding: 12rpx 0 28rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.25);
}
.sum-card__k {
  font-size: 34rpx;
  opacity: 0.9;
}
.sum-card__big {
  margin-top: 8rpx;
}
.sum-card__num {
  font-size: 84rpx;
  font-weight: 700;
  line-height: 1.2;
}
.sum-card__u {
  font-size: 36rpx;
  margin-left: 10rpx;
}
.sum-card__grid {
  display: flex;
  padding-top: 24rpx;
}
.sum-card__item {
  flex: 1;
  text-align: center;
}
.sum-card__v {
  font-size: 46rpx;
  font-weight: 700;
}
.sum-card__label {
  font-size: 30rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

/* ---------------- 三列表格 ---------------- */
.table {
  border: 2rpx solid #e3e6eb;
  border-radius: 16rpx;
  overflow: hidden;
}
.table__head {
  display: flex;
  background: #f2f4f7;
  height: 96rpx;
  line-height: 96rpx;
}
.table__th {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
}
.table__sort {
  font-style: normal;
  font-size: 28rpx;
  color: #8a94a6;
  margin-left: 6rpx;
}
.table__c1 {
  width: 30%;
  text-align: center;
}
.table__c2 {
  width: 34%;
  text-align: center;
}
.table__c3 {
  width: 36%;
  text-align: center;
}

.table__row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  border-top: 2rpx solid #f0f2f5;
}
.table__row--odd {
  background: #fafbfc;
}
.table__td {
  padding: 14rpx 0;
  text-align: center;
}
.table__c3 {
  text-align: center;
  padding-right: 0;
}
.table__md {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
}
.table__week {
  font-size: 28rpx;
  color: #8a94a6;
  text-align: center;
  margin-top: 2rpx;
}
.table__hours {
  color: #1a1a1a;
}
.table__hours .num {
  font-size: 52rpx;
  font-weight: 700;
}
.table__h {
  font-size: 28rpx;
  color: #4e5969;
  margin-left: 6rpx;
}
.table__units {
  font-size: 28rpx;
  color: #8a94a6;
  margin-top: 2rpx;
}

/* 无出勤日期的班次占位 */
.table__none {
  color: #a3a8b0;
}

/* 行点击反馈 */
.table__row--hover {
  background: #e7f0ff;
}
.table__tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 30rpx;
  color: #8a94a6;
}

/* 补记弹层：内容更高（滚动由全局 .sheet__body 承担，底栏固定） */
.sheet--tall {
  max-height: 90vh;
}

/* 当天记录 */
.day-rec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
  border-bottom: 2rpx solid #f0f2f5;
}
.day-rec__l {
  flex: 1;
  min-width: 0;
}
.day-rec__time {
  display: block;
  font-size: 30rpx;
  color: #8a94a6;
  margin-top: 0;
}
.day-rec__cap {
  display: block;
  font-size: 26rpx;
  color: #b25e09;
  margin-top: 2rpx;
}
.day-rec__r {
  flex-shrink: 0;
  text-align: right;
}
.day-rec__h {
  font-size: 44rpx;
  font-weight: 700;
}
.day-rec__u {
  font-size: 30rpx;
  color: #4e5969;
  margin-left: 6rpx;
}
.day-rec__del {
  display: inline-block;
  margin-left: 20rpx;
  padding: 10rpx 20rpx;
  font-size: 32rpx;
  color: #e34d59;
  background: #fdeff0;
  border-radius: 10rpx;
}
.day-sum {
  margin-top: 4rpx;
  padding: 8rpx 20rpx;
  background: #e7f0ff;
  border-radius: 14rpx;
  font-size: 36rpx;
  color: #1a1a1a;
  text-align: center;
}
.day-sum .num {
  font-size: 44rpx;
  font-weight: 700;
  color: #0052d9;
}

.empty--in-sheet {
  padding: 12rpx 0;
}

.foot-space {
  height: 12rpx;
}
