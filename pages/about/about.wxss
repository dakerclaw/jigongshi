.page {
  min-height: 100vh;
  padding: 16rpx 0 calc(48rpx + env(safe-area-inset-bottom));
}

/* 顶部介绍 */
.about-hero {
  text-align: center;
  padding: 36rpx 32rpx 32rpx;
}
.about-hero__icon {
  font-size: 96rpx;
  line-height: 1;
}
.about-hero__name {
  margin-top: 12rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.about-hero__ver {
  margin-top: 6rpx;
  font-size: 30rpx;
  color: #667085;
}
.about-hero__desc {
  margin-top: 10rpx;
  font-size: 32rpx;
  color: #4e5969;
}

/* 数据管理 */
.about-stats {
  display: flex;
  padding: 12rpx 0 18rpx;
  border-bottom: 2rpx solid #f0f2f5;
}
.about-stat {
  flex: 1;
  text-align: center;
  min-width: 0;
}
.about-stat__v {
  font-size: 44rpx;
  font-weight: 700;
  color: #0052d9;
}
.about-stat__v--text {
  font-size: 28rpx;
  line-height: 1.4;
  color: #4e5969;
}
.about-stat__k {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: #667085;
}
.about-last {
  padding: 16rpx 0 0;
  font-size: 30rpx;
  color: #4e5969;
}
.about-tip {
  margin: 16rpx 0;
  padding: 16rpx var(--pad-block);
  border-radius: 12rpx;
  background: #f7f9fc;
  font-size: 28rpx;
  line-height: 1.6;
  color: #4e5969;
}
.about-btn {
  margin-top: 16rpx;
  height: 104rpx;
  line-height: 104rpx;
  font-size: 34rpx;
}
.about-btn--danger {
  color: #c62828;
  background: #fdeff0;
}
.about-warn {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #b25e09;
  text-align: center;
}

/* 隐私 */
.privacy-item {
  font-size: 31rpx;
  line-height: 1.7;
  color: #4e5969;
  margin: 6rpx 0;
}

/* 关于 */
.about-line {
  font-size: 30rpx;
  line-height: 1.7;
  color: #4e5969;
  margin: 6rpx 0;
}
.about-line--muted {
  margin-top: 14rpx;
  color: #667085;
}

.about-foot {
  padding: 24rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #667085;
}
