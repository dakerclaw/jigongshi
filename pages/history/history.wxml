<view class="page">
  <!-- 月份选择 -->
  <view class="card top-bar">
    <view class="top-bar__label">查询月份</view>
    <picker mode="date" fields="month" value="{{ym}}" end="{{currentYm}}" bindchange="onMonthChange">
      <view class="top-bar__pill">{{ymText}} ▾</view>
    </picker>
  </view>

  <!-- 汇总 -->
  <view class="card sum-card">
    <view class="sum-card__row">
      <view class="sum-card__k">{{ymText}} 出勤总工时</view>
      <view class="sum-card__big">
        <text class="num sum-card__num">{{totalHours}}</text>
        <text class="sum-card__u">小时</text>
      </view>
    </view>
    <view class="sum-card__grid">
      <view class="sum-card__item">
        <view class="sum-card__v num">{{totalUnits}}</view>
        <view class="sum-card__label">折合工时（个）</view>
      </view>
      <view class="sum-card__item">
        <view class="sum-card__v num">{{workDays}}</view>
        <view class="sum-card__label">出勤天数</view>
      </view>
      <view class="sum-card__item">
        <view class="sum-card__v num">{{avgHours}}</view>
        <view class="sum-card__label">日均（小时）</view>
      </view>
    </view>
    <view class="sum-note">折合工时按每日工时 ÷ 8 保留两位小数后逐日相加</view>
  </view>

  <!-- 每日出勤月历 -->
  <view class="card">
    <view class="cal-title">{{calendar.title}}</view>
    <view class="cal-week">
      <view class="cal-week__cell" wx:for="{{calendar.weekdays}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="cal-body">
      <view class="cal-row" wx:for="{{calendar.weeks}}" wx:key="index" wx:for-item="week">
        <view class="cal-cell" wx:for="{{week}}" wx:key="index" wx:for-item="cell">
          <view
            wx:if="{{cell}}"
            class="cal-cell__inner {{cell.theme ? 'cal-cell--' + cell.theme : ''}}"
          >
            <view class="cal-cell__day">{{cell.day}}</view>
            <view class="cal-cell__lunar">{{cell.lunar}}</view>
          </view>
          <view wx:else class="cal-cell__inner cal-cell__inner--empty"></view>
        </view>
      </view>
    </view>
    <view class="cal-legend" wx:if="{{legend.length}}">
      <view class="cal-legend__item" wx:for="{{legend}}" wx:key="name">
        <view class="cal-legend__dot cal-legend__dot--{{item.theme}}"></view>
        <text>{{item.name}}出勤</text>
      </view>
    </view>
    <view class="cal-empty" wx:if="{{!rows.length}}">该月暂无出勤记录</view>
  </view>

  <!-- 复制查询结果 -->
  <view
    class="big-btn big-btn--ghost copy-btn {{rows.length ? '' : 'big-btn--disabled'}}"
    bindtap="onCopyMonth"
  >
    复制查询结果
  </view>

  <view class="foot-space"></view>
</view>
