.page {
  padding-bottom: 220rpx;
  min-height: 100vh;
}

/* ---------------- 月份选择 ---------------- */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}
.picker-row--sub {
  border-top: 2rpx solid #f0f2f5;
  padding-top: 16rpx;
  margin-top: 8rpx;
}
.picker-row__label {
  font-size: 34rpx;
  color: #4e5969;
  font-weight: 600;
}
.picker-row__value {
  font-size: 40rpx;
  white-space: nowrap;
  font-weight: 700;
  color: #0052d9;
  background: #e7f0ff;
  padding: 22rpx 48rpx;
  border-radius: 20rpx;
}

.quick {
  display: flex;
}
.quick__item {
  margin-left: 14rpx;
  padding: 10rpx 26rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #4e5969;
  background: #f2f4f7;
  border: 2rpx solid #e3e6eb;
  border-radius: 12rpx;
}
.quick__item.is-active {
  color: #fff;
  background: #0052d9;
  border-color: #0052d9;
}

/* ---------------- 汇总卡 ---------------- */
.sum-card {
  background: linear-gradient(135deg, #0052d9, #2b7bff);
  color: #fff;
}
.sum-card__row {
  text-align: center;
  padding: 10rpx 0 22rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.25);
}
.sum-card__k {
  font-size: 34rpx;
  opacity: 0.9;
}
.sum-card__big {
  margin-top: 8rpx;
}
.sum-card__num {
  font-size: 84rpx;
  font-weight: 700;
  line-height: 1.2;
}
.sum-card__u {
  font-size: 36rpx;
  margin-left: 10rpx;
}
.sum-card__grid {
  display: flex;
  padding-top: 18rpx;
}
.sum-card__item {
  flex: 1;
  text-align: center;
}
.sum-card__v {
  font-size: 46rpx;
  font-weight: 700;
}
.sum-card__label {
  font-size: 30rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

/* ---------------- 班次分布 ---------------- */
.stat-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.stat-row__name {
  flex-shrink: 0;
  width: 130rpx;
  text-align: center;
}
.stat-row__bar {
  flex: 1;
  height: 44rpx;
  background: #f2f4f7;
  border-radius: 22rpx;
  overflow: hidden;
  margin: 0 20rpx;
}
.stat-row__fill {
  height: 44rpx;
  border-radius: 22rpx;
  transition: width 0.3s;
}
.stat-row__fill--day {
  background: #f5a623;
}
.stat-row__fill--mid {
  background: #00a870;
}
.stat-row__fill--night {
  background: #5b4bd6;
}
.stat-row__v {
  flex-shrink: 0;
  width: 170rpx;
  text-align: right;
  white-space: nowrap;
  font-size: 38rpx;
  font-weight: 700;
}
.stat-row__u {
  font-size: 28rpx;
  font-weight: 400;
  color: #4e5969;
  margin-left: 4rpx;
}

/* ---------------- 各月对比 ---------------- */
.bar-item {
  display: flex;
  align-items: center;
  padding: 14rpx 12rpx;
  border-radius: 14rpx;
  margin-bottom: 4rpx;
}
.bar-item.is-active {
  background: #e7f0ff;
}
.bar-item__label {
  flex-shrink: 0;
  width: 200rpx;
  font-size: 30rpx;
  white-space: nowrap;
  color: #4e5969;
}
.bar-item__track {
  flex: 1;
  height: 40rpx;
  background: #f2f4f7;
  border-radius: 20rpx;
  overflow: hidden;
  margin: 0 12rpx;
}
.bar-item__fill {
  height: 40rpx;
  background: #a8c5ff;
  border-radius: 20rpx;
  transition: width 0.3s;
}
.bar-item__fill.is-active {
  background: #0052d9;
}
.bar-item__v {
  flex-shrink: 0;
  width: 170rpx;
  text-align: right;
  white-space: nowrap;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

/* ---------------- 每日明细 ---------------- */
.hrow {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f2f5;
}
.hrow:last-child {
  border-bottom: none;
}
.hrow__date {
  width: 200rpx;
}
.hrow__md {
  font-size: 36rpx;
  font-weight: 700;
}
.hrow__week {
  font-size: 28rpx;
  color: #8a94a6;
  margin-top: 2rpx;
}
.hrow__shift {
  flex: 1;
}
.hrow__val {
  text-align: right;
  min-width: 170rpx;
}
.hrow__val .num {
  font-size: 46rpx;
  font-weight: 700;
}
.hrow__u {
  font-size: 28rpx;
  color: #4e5969;
  margin-left: 6rpx;
}
.hrow__units {
  font-size: 28rpx;
  color: #8a94a6;
}

.foot-space {
  height: 12rpx;
}

/* 复制查询结果按钮：与卡片对齐（左右 24rpx 间距） */
.copy-btn {
  margin: 16rpx 24rpx;
}
