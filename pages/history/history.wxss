.page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
}

/* ---------------- 月份选择（三页统一样式见 app.wxss .top-bar） ---------------- */

/* ---------------- 汇总卡 ---------------- */
.sum-card {
  background: linear-gradient(135deg, #0052d9, #2b7bff);
  color: #fff;
}
.sum-card__row {
  text-align: center;
  padding: 10rpx 0 22rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.25);
}
.sum-card__k {
  font-size: 34rpx;
  opacity: 0.9;
}
.sum-card__big {
  margin-top: 8rpx;
}
.sum-card__num {
  font-size: 84rpx;
  font-weight: 700;
  line-height: 1.2;
}
.sum-card__u {
  font-size: 36rpx;
  margin-left: 10rpx;
}
.sum-card__grid {
  display: flex;
  padding-top: 18rpx;
}
.sum-card__item {
  flex: 1;
  text-align: center;
}
.sum-card__v {
  font-size: 46rpx;
  font-weight: 700;
}
.sum-card__label {
  font-size: 30rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}
.sum-note {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.25);
  text-align: center;
  font-size: 26rpx;
  line-height: 1.5;
  opacity: 0.9;
}

/* ---------------- 出勤月历 ---------------- */
.cal-week {
  display: flex;
  margin-bottom: 8rpx;
}
.cal-week__cell {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #667085;
  padding: 8rpx 0;
}
.cal-row {
  display: flex;
}
.cal-cell {
  flex: 1;
  aspect-ratio: 1;
  padding: 2rpx;
}
.cal-cell__inner {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}
.cal-cell__inner--empty {
  background: transparent;
}
.cal-cell__day {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.2;
}
.cal-cell__lunar {
  font-size: 20rpx;
  color: #6b7688;
  line-height: 1.3;
}

/* 出勤着色：白班 / 中班 / 夜班 */
.cal-cell--day {
  background: #fff3dd;
  border: 2rpx solid #f5a623;
}
.cal-cell--day .cal-cell__day {
  color: #a35b00;
}
.cal-cell--day .cal-cell__lunar {
  color: #c98a3d;
}
.cal-cell--mid {
  background: #e0f6ee;
  border: 2rpx solid #00a870;
}
.cal-cell--mid .cal-cell__day {
  color: #00684a;
}
.cal-cell--mid .cal-cell__lunar {
  color: #3f9a7c;
}
.cal-cell--night {
  background: #e9e6fb;
  border: 2rpx solid #5b4bd6;
}
.cal-cell--night .cal-cell__day {
  color: #3a2f96;
}
.cal-cell--night .cal-cell__lunar {
  color: #7a6fd0;
}

/* 图例 */
.cal-legend {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #f0f2f5;
}
.cal-legend__item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #4e5969;
  margin: 4rpx 18rpx;
}
.cal-legend__dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
}
.cal-legend__dot--day {
  background: #fff3dd;
  border: 2rpx solid #f5a623;
}
.cal-legend__dot--mid {
  background: #e0f6ee;
  border: 2rpx solid #00a870;
}
.cal-legend__dot--night {
  background: #e9e6fb;
  border: 2rpx solid #5b4bd6;
}
.cal-empty {
  text-align: center;
  font-size: 28rpx;
  color: #6b7688;
  padding: 20rpx 0 4rpx;
}

.foot-space {
  height: 12rpx;
}

/* 复制查询结果按钮：与卡片对齐（左右 24rpx 间距） */
.copy-btn {
  margin: 16rpx 24rpx;
}
