<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="path"
    class="tabbar__item {{selected === index ? 'is-active' : ''}}"
    data-index="{{index}}"
    data-path="{{item.path}}"
    bindtap="onSwitch"
    hover-class="tabbar__item--hover"
  >
    <view class="tabbar__icon">{{item.icon}}</view>
    <view class="tabbar__text">{{item.text}}</view>
  </view>
</view>
